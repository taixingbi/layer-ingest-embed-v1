# Copy to .env and fill in. Required vars must be non-empty or startup fails.
# Optional for local Qdrant: leave QDRANT_API_KEY unset or empty.
# Optional env file layers: .env.dev / .env.prod via `python main.py --env dev`.

QDRANT_URL=https://your-cluster.example.com:6333
QDRANT_API_KEY=

EMBEDDING_URL=http://127.0.0.1:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_INTERNAL_KEY=change-me

COLLECTION_NAME=taixing_knowledge
DATA_DIR=./data

VECTOR_SIZE=1024
BATCH_SIZE=100
